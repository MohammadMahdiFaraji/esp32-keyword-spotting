#include "modele.h"  // فایل مدل TFLite شما
#include <tflm_esp32.h>           // کتابخانه TensorFlow Lite برای ESP32
#include <eloquent_tinyml.h>      // کتابخانه EloquentTinyML

#define TF_NUM_OPS 4              // تعداد عملیات مورد استفاده در مدل (Fully Connected، Softmax، و اینا
#define ARENA_SIZE 16000          // اندازه حافظه که برای اجرا مدل تخصیص دادیم
#define NUM_INPUTS 650            // تعداد ویژگی‌های MFCC (ویژگی‌های شما)
#define NUM_OUTPUTS 4             // تعداد کلاس‌ها (HI, BYE, YES, NO)

