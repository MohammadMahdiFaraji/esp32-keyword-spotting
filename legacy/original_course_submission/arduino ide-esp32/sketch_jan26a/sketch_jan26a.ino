const char* class_names[] = {"right", "left", "yes", "no"};

// آرنا و تفسیرگر مدل
uint8_t tensor_arena[ARENA_SIZE]
tflite::MicroInterpreter* interpreter;

// تعریف مدل از حافظه فلش
const tflite::Model* model = tflite::GetModel(modele_tflite);

