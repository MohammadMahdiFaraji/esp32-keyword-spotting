void loop() {
}



void testPrediction(float* sample) {
    // کپی ویژگی‌ها به ورودی مدل
    for (int i = 0; i < NUM_INPUTS; i++) {
        input_tensor->data.f[i] = sample[i];
    }

    // اجرای مدل
    if (interpreter->Invoke() == kTfLiteOk) {
        int maxIndex = 0;
        float maxProb = 0;

        for (int i = 0; i < NUM_OUTPUTS; i++) {
            float prob = output_tensor->data.f[i];
            Serial.print("Class ");
            Serial.print(class_names[i]);
            Serial.print(": ");
            Serial.println(prob, 6);

            if (prob > maxProb) {
                maxProb = prob;
                maxIndex = i;
            }
        }

      //print the results:
        Serial.print("Predicted class: ");
        Serial.println(class_names[maxIndex]);
        Serial.print("Confidence: ");
        Serial.println(maxProb, 6);

        for (int i = 0; i < NUM_OUTPUTS; i++) {
            digitalWrite(ledPins[i], i == maxIndex ? HIGH : LOW);
        }
    } else {
        Serial.println("Error during prediction.");
    }
}
